<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Needed only for hardened-runtime (notarized) builds: the bundled backend is a
    PyInstaller one-file executable that unpacks the Python runtime and native
    extension modules into a temporary directory and loads them at startup.
    Those extracted libraries are not signed by our Team ID, so library
    validation must be relaxed, and CPython/ctypes needs writable+executable memory.
  -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
