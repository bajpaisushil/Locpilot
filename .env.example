# LocPilot backend configuration (all optional). Export these in your shell before scripts/dev.sh
# (LocPilot reads environment variables only; it does not load .env files).
# No secrets are required: LocPilot only talks to a local Ollama daemon.

# Local model served by Ollama (any installed chat model works). If it isn't installed but other chat
# models are, LocPilot uses one of those instead (and remembers it, like a choice in Settings).
LOCPILOT_MODEL=mimo-v2.6:9b-q4_K_M
LOCPILOT_OLLAMA_URL=http://127.0.0.1:11434
# How long Ollama keeps the model in RAM after the last request ("10m", "1h", "0" = unload at once).
# LocPilot also unloads the models it loaded when it quits or you switch models.
LOCPILOT_OLLAMA_KEEP_ALIVE=30m
# Context window passed to Ollama (larger = more evidence per step, more RAM). Left unset, LocPilot uses 16384,
# or 32768 for models that hold context cheaply (MiMo/Qwen3.5: about 1 GB for 32k) on machines with 16 GB or more.
# LOCPILOT_NUM_CTX=16384
# Thinking models (MiMo, Qwen3, …) reason before answering unless told not to. "off" (fastest; as accurate in
# LocPilot's benchmark), "auto" = only in root-cause analysis and failure diagnosis, "on" = every step (slowest).
# Models that cannot think ignore it.
LOCPILOT_THINKING=off
# Output tokens the reasoning may use per step, on top of the answer's own budget.
LOCPILOT_THINKING_TOKENS=4096
LOCPILOT_TEMPERATURE=0.1
# Non-loopback Ollama URLs are refused unless you explicitly opt in.
LOCPILOT_ALLOW_REMOTE_OLLAMA=false
# Start an installed-but-stopped local Ollama automatically (the Ollama app on macOS, else `ollama serve`).
LOCPILOT_AUTOSTART_OLLAMA=true
# The ollama binary to start, when it is not in a standard location (default: found automatically).
# LOCPILOT_OLLAMA_PATH=/path/to/ollama

# Backend binding (loopback only) and data location.
LOCPILOT_HOST=127.0.0.1
LOCPILOT_PORT=8420
LOCPILOT_DATA_DIR=~/.locpilot

# Where local repositories may live (comma-separated). Default: your home directory.
LOCPILOT_ALLOWED_REPO_ROOTS=~
# Hosts accepted for "clone from URL".
LOCPILOT_ALLOWED_GIT_HOSTS=github.com,gitlab.com,bitbucket.org
# Browser origins allowed to call the API (dev UI + Tauri webview).
LOCPILOT_ALLOWED_ORIGINS=http://127.0.0.1:5420,http://localhost:5420,tauri://localhost,http://tauri.localhost,https://tauri.localhost

# Agent limits.
LOCPILOT_MAX_RETRIES=2
# Model calls per turn (a step in which the model works with tools is several short calls).
LOCPILOT_MAX_LLM_CALLS=60
# Tool-capable models (MiMo, Qwen3-Coder, …) explore and edit by calling tools. false = text protocol for all.
LOCPILOT_NATIVE_TOOLS=true
# Before a change is proposed, check it against the request (one extra model call) and revise it if needed.
LOCPILOT_CHECK_CHANGES=true
LOCPILOT_MAX_EVIDENCE_ROUNDS=2
LOCPILOT_COMMAND_TIMEOUT_S=300
# Commands you run yourself from the Commands tab (they also have a Stop button).
LOCPILOT_USER_COMMAND_TIMEOUT_S=900
LOCPILOT_MAX_OUTPUT_BYTES=200000

# Terminal tab: your login shell by default (e.g. LOCPILOT_TERMINAL_SHELL="/bin/zsh -l").
# LOCPILOT_TERMINAL_SHELL=
LOCPILOT_MAX_TERMINALS=8

# Only one backend may use a data directory; a starting backend waits this long for a previous one to exit.
LOCPILOT_LOCK_WAIT_S=15

# Test-command sandbox: "auto" (Seatbelt on macOS, bubblewrap on Linux) or "off".
LOCPILOT_SANDBOX=auto
LOCPILOT_SANDBOX_ALLOW_LOCALHOST=false

# Write every prompt/response to <data dir>/logs/llm-debug.jsonl (local only; for debugging).
LOCPILOT_DEBUG_LLM=false

# Set automatically by the desktop app / scripts/dev.sh — do not hard-code.
# LOCPILOT_AUTH_TOKEN=
