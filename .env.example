# LocPilot backend configuration (all optional). Export these in your shell before scripts/dev.sh
# (LocPilot reads environment variables only; it does not load .env files).
# No secrets are required: LocPilot only talks to a local Ollama daemon.

# Local model served by Ollama (any installed chat model works).
LOCPILOT_MODEL=qwen2.5-coder:7b
LOCPILOT_OLLAMA_URL=http://127.0.0.1:11434
# Context window passed to Ollama (larger = more evidence per step, more RAM).
LOCPILOT_NUM_CTX=16384
LOCPILOT_TEMPERATURE=0.1
# Non-loopback Ollama URLs are refused unless you explicitly opt in.
LOCPILOT_ALLOW_REMOTE_OLLAMA=false

# Backend binding (loopback only) and data location.
LOCPILOT_HOST=127.0.0.1
LOCPILOT_PORT=8420
LOCPILOT_DATA_DIR=~/.locpilot

# Where local repositories may live (comma-separated). Default: your home directory.
LOCPILOT_ALLOWED_REPO_ROOTS=~
# Hosts accepted for "clone from URL".
LOCPILOT_ALLOWED_GIT_HOSTS=github.com,gitlab.com,bitbucket.org
# Browser origins allowed to call the API (dev UI + Tauri webview).
LOCPILOT_ALLOWED_ORIGINS=http://127.0.0.1:5420,http://localhost:5420,tauri://localhost,http://tauri.localhost,https://tauri.localhost

# Agent limits.
LOCPILOT_MAX_RETRIES=2
LOCPILOT_MAX_LLM_CALLS=24
LOCPILOT_MAX_EVIDENCE_ROUNDS=2
LOCPILOT_COMMAND_TIMEOUT_S=300
# Commands you run yourself from the Commands tab (they also have a Stop button).
LOCPILOT_USER_COMMAND_TIMEOUT_S=900
LOCPILOT_MAX_OUTPUT_BYTES=200000

# Terminal tab: your login shell by default (e.g. LOCPILOT_TERMINAL_SHELL="/bin/zsh -l").
# LOCPILOT_TERMINAL_SHELL=
LOCPILOT_MAX_TERMINALS=8

# Only one backend may use a data directory; a starting backend waits this long for a previous one to exit.
LOCPILOT_LOCK_WAIT_S=10

# Test-command sandbox: "auto" (Seatbelt on macOS, bubblewrap on Linux) or "off".
LOCPILOT_SANDBOX=auto
LOCPILOT_SANDBOX_ALLOW_LOCALHOST=false

# Write every prompt/response to <data dir>/logs/llm-debug.jsonl (local only; for debugging).
LOCPILOT_DEBUG_LLM=false

# Set automatically by the desktop app / scripts/dev.sh — do not hard-code.
# LOCPILOT_AUTH_TOKEN=
